#!/usr/bin/env bash
#
# install-fonts — fonts that apt does not have.
#
# Three sources, because fonts arrive three ways:
#
#   nerd      patched Nerd Fonts from upstream's releases (72 families)
#   aporetic  Protesilaos Stavrou's Iosevka build — shipped in a git repo,
#             not as releases, so it is cloned rather than downloaded
#   local     a directory of font files and archives you already have
#
# Everything installs per user into ~/.local/share/fonts. None of it needs
# root, and a font out of a zip file has no business in /usr/share.
#
# Usage:
#   ./install-fonts nerd                    # the default set below
#   ./install-fonts nerd Hack Iosevka       # specific families
#   ./install-fonts --list-nerd             # what upstream offers
#   ./install-fonts aporetic
#   ./install-fonts local ~/path/to/fonts
#   ./install-fonts --enable-bitmaps        # make fontconfig stop ignoring them
#
# ON LICENSED FONTS: `local` copies files, it does not publish them. Fonts
# you paid for — Comic Code and the like — belong wherever you keep them,
# not in a dotfiles repo. Installing from a synced folder at setup time
# keeps a licensed font off a public git remote, which is the entire reason
# this takes a path instead of vendoring anything.
#
set -euo pipefail

FONT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
NERD_BASE="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"
APORETIC_REPO="https://github.com/protesilaos/aporetic"

# Sensible default set: one for the terminal, one for the bar's glyphs.
NERD_DEFAULT=(FiraCode CascadiaCode NerdFontsSymbolsOnly)

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] && die "Run as your normal user, not root. These install into your home."

# ---------------------------------------------------------------------------
have_fonts() { find "$1" \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' \) -print -quit 2>/dev/null | grep -q .; }

# Copy every font file under $1 into $FONT_DIR/$2, flattened.
harvest() {
  local src="$1" dest="$FONT_DIR/$2" n=0 f
  mkdir -p "$dest"
  while IFS= read -r -d '' f; do
    cp -f "$f" "$dest/" && n=$((n + 1))
  done < <(find "$src" \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' \) -print0 2>/dev/null)
  printf '%s' "$n"
}

# ---------------------------------------------------------------------------
install_nerd() {
  local names=("$@")
  [[ ${#names[@]} -gt 0 ]] || names=("${NERD_DEFAULT[@]}")

  command -v tar >/dev/null || die "tar not found"
  local name dest tmp
  for name in "${names[@]}"; do
    dest="$FONT_DIR/$name"
    if [[ -d "$dest" ]]; then
      say "$name already present — skipping"
      continue
    fi

    tmp="$(mktemp -d)" || die "mktemp failed"
    say "Downloading $name"
    if ! curl -fL --proto '=https' --tlsv1.2 -o "$tmp/f.tar.xz" "$NERD_BASE/${name}.tar.xz"; then
      warn "No such archive: ${name}.tar.xz — see --list-nerd"
      rm -rf "$tmp"; continue
    fi
    mkdir -p "$dest"
    if ! tar -xJf "$tmp/f.tar.xz" -C "$dest"; then
      warn "Could not extract $name (is xz-utils installed?)"
      rm -rf "$tmp" "$dest"; continue
    fi
    rm -rf "$tmp"
    # The archives carry "Windows Compatible" duplicates of every face, which
    # otherwise show up twice in every font picker.
    find "$dest" -name '*Windows Compatible*' -delete 2>/dev/null || true
    say "Installed $name"
  done
}

list_nerd() {
  say "Patched families upstream currently offers"
  curl -fsSL https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest 2>/dev/null \
    | grep -oE '"name": *"[^"]*\.tar\.xz"' | cut -d'"' -f4 | sed 's/\.tar\.xz$//' | sort \
    | pr -4 -t -w 100 2>/dev/null || warn "Could not reach the releases API"
}

# ---------------------------------------------------------------------------
# Aporetic ships as directories of TTFs inside the git repo — there are no
# release tarballs — so this clones shallowly and copies the hinted builds.
install_aporetic() {
  command -v git >/dev/null || die "git not found. sudo apt install git"

  local tmp n
  tmp="$(mktemp -d)" || die "mktemp failed"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  say "Cloning Aporetic"
  git clone --depth 1 --quiet "$APORETIC_REPO" "$tmp/aporetic" \
    || die "Clone failed"

  local fam
  for fam in aporetic-sans aporetic-sans-mono aporetic-serif aporetic-serif-mono; do
    # TTF is hinted; TTF-Unhinted also ships. Hinted is the better default on
    # a laptop panel at 1x scaling.
    if [[ -d "$tmp/aporetic/$fam/TTF" ]]; then
      n="$(harvest "$tmp/aporetic/$fam/TTF" Aporetic)"
      printf '  %-22s %s files\n' "$fam" "$n"
    else
      warn "  $fam/TTF not found in the repo — layout may have changed"
    fi
  done
}

# ---------------------------------------------------------------------------
# A directory of whatever you happen to have: loose fonts, zips, tarballs,
# vendor folders three levels deep.
install_local() {
  local dir="$1"
  [[ -d "$dir" ]] || die "Not a directory: $dir"

  say "Sweeping $dir"
  local f base stem tmp n total=0 loose=0 bitmaps=()

  # nocasematch rather than ${base,,}: same effect on the case below, and it
  # does not need bash 4, so this stays testable on an older shell.
  shopt -s nocasematch
  while IFS= read -r -d '' f; do
    base="$(basename "$f")"
    case "$base" in
      *.ttf|*.otf|*.ttc)
        mkdir -p "$FONT_DIR/local"
        cp -f "$f" "$FONT_DIR/local/" && { total=$((total + 1)); loose=$((loose + 1)); }
        ;;
      *.zip)
        command -v unzip >/dev/null || { warn "unzip not installed; skipping $base"; continue; }
        tmp="$(mktemp -d)" || continue
        unzip -qq -o "$f" -d "$tmp" 2>/dev/null || warn "  could not unzip $base"
        n="$(harvest "$tmp" "${base%.*}")"; total=$((total + n))
        printf '  %-40s %s files\n' "$base" "$n"
        rm -rf "$tmp"
        ;;
      *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2)
        tmp="$(mktemp -d)" || continue
        tar -xf "$f" -C "$tmp" 2>/dev/null || warn "  could not extract $base"
        # Strip the whole archive suffix, not everything after the first
        # dot — "tamsyn-font-1.11.tar.gz" would otherwise become
        # "tamsyn-font-1".
        stem="$base"
        case "$stem" in
          *.tar.gz|*.tar.xz|*.tar.bz2) stem="${stem%.tar.*}" ;;
          *.tgz)                       stem="${stem%.tgz}" ;;
        esac
        n="$(harvest "$tmp" "$stem")"; total=$((total + n))
        printf '  %-40s %s files\n' "$base" "$n"
        # Bitmap fonts extract to .pcf/.psf and fontconfig ignores them by
        # default on Debian. Copy them anyway, but say so.
        if find "$tmp" \( -iname '*.pcf' -o -iname '*.pcf.gz' -o -iname '*.psf' -o -iname '*.psf.gz' \) -print -quit | grep -q .; then
          mkdir -p "$FONT_DIR/$stem"
          find "$tmp" \( -iname '*.pcf' -o -iname '*.pcf.gz' -o -iname '*.psf' -o -iname '*.psf.gz' \) \
            -exec cp -f {} "$FONT_DIR/$stem/" \; 2>/dev/null || true
          bitmaps+=("$base")
        fi
        rm -rf "$tmp"
        ;;
    esac
  done < <(find "$dir" -maxdepth 1 -type f -print0)
  shopt -u nocasematch
  [[ $loose -gt 0 ]] && printf '  %-40s %s files\n' "(loose font files)" "$loose"

  # Vendor folders: anything loose in a subdirectory tree.
  while IFS= read -r -d '' d; do
    if have_fonts "$d"; then
      n="$(harvest "$d" "$(basename "$d")")"
      total=$((total + n))
      printf '  %-40s %s files\n' "$(basename "$d")/" "$n"
    fi
  done < <(find "$dir" -maxdepth 1 -mindepth 1 -type d -print0)

  say "$total font files installed"

  if [[ ${#bitmaps[@]} -gt 0 ]]; then
    echo
    warn "Bitmap fonts found in: ${bitmaps[*]}"
    warn "Debian's fontconfig ignores bitmap fonts by default, so these are"
    warn "installed and invisible until you run:  $0 --enable-bitmaps"
  fi

  cat <<'EOF'

  Licensed fonts stay here, not in a repo. Anything you paid for — Comic
  Code and the like — is licensed to you, and a public dotfiles remote is
  publication. Installing from a synced folder keeps it off the remote.

EOF
}

# ---------------------------------------------------------------------------
enable_bitmaps() {
  local avail=/usr/share/fontconfig/conf.avail/70-force-bitmaps.conf
  local link=/etc/fonts/conf.d/70-force-bitmaps.conf
  local block=/etc/fonts/conf.d/70-no-bitmaps-and-emoji.conf

  [[ -f "$avail" ]] || die "$avail not found — is fontconfig-config installed?"

  say "Enabling bitmap fonts in fontconfig"
  [[ -e "$block" ]] && { sudo rm -f "$block"; echo "  removed $(basename "$block")"; }
  sudo ln -sf "$avail" "$link"
  echo "  linked $(basename "$avail")"
  fc-cache -f >/dev/null 2>&1 || warn "fc-cache failed"
  say "Done. Bitmap fonts like Tamsyn will now render."
}

# ---------------------------------------------------------------------------
mkdir -p "$FONT_DIR"

case "${1:-}" in
  nerd)             shift; install_nerd "$@" ;;
  aporetic)         install_aporetic ;;
  local)            [[ -n "${2:-}" ]] || die "local needs a directory: $0 local ~/path/to/fonts"
                    install_local "$2" ;;
  --list-nerd)      list_nerd; exit 0 ;;
  --enable-bitmaps) enable_bitmaps; exit 0 ;;
  -h|--help|"")     sed -n "2,/^set -euo/p" "$0" | sed '$d'; exit 0 ;;
  *)                die "unknown command: $1  (try --help)" ;;
esac

# ---------------------------------------------------------------------------
say "Rebuilding the font cache"
fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || warn "fc-cache failed"

# Verify rather than assume: a font that failed to register shows up much
# later as a config naming something fontconfig cannot find, and silently
# substituting something else.
# Scoped to what is actually in FONT_DIR — a bare `fc-list` reports every
# font on the system, which says nothing about whether this worked.
say "Now installed under $FONT_DIR"
for d in "$FONT_DIR"/*/; do
  [[ -d "$d" ]] || continue
  printf '  %-30s %s files\n' "$(basename "$d")" "$(find "$d" -type f | wc -l | tr -d ' ')"
done
echo
echo "  Confirm a family name before naming it in a config — what fontconfig"
echo "  calls a font is often not what the file is called:"
echo "    fc-list | grep -i aporetic"
