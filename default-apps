#!/usr/bin/env bash
#
# default-apps — set which application opens which file type.
#
# On a bare WM nothing arbitrates this. Every application that can open a
# PDF says so in its .desktop file, and with no user preference recorded the
# first match in the cache wins — which is why PDFs open in GIMP. GIMP is
# not misbehaving; nobody ever said what you wanted.
#
# Preferences live in ~/.config/mimeapps.list under [Default Applications].
# This writes them through xdg-mime rather than editing that file, so the
# cache stays consistent.
#
# Desktop-file IDs are discovered, never assumed: zathura's is
# org.pwmt.zathura.desktop, not zathura.desktop, and that sort of guess is
# how you end up with a preference pointing at nothing. Each MIME type below
# lists candidates in order and the first one actually installed wins.
#
# Usage:
#   ./default-apps            # fill in the types you have not chosen yourself
#   ./default-apps --list     # show what opens what right now
#   ./default-apps --dry-run  # show what would change, change nothing
#   ./default-apps --force    # also overwrite choices you already made
#
# By default it only touches types you have NOT expressed a preference about.
# A type that already has an entry in mimeapps.list was chosen by you — or by
# an application on your behalf — and silently replacing that is worse than
# leaving a wrong default in place, because you would never know it happened.
#
# Note this is not the same as what a type currently RESOLVES to. With no
# preference recorded, `xdg-mime query default` still answers, from the first
# match in the cache. That answer is exactly the problem: it is why PDFs open
# in GIMP. So the test is whether mimeapps.list mentions the type, not what
# the query returns.
#
set -euo pipefail

[[ $EUID -eq 0 ]] && { echo "Run as your normal user, not root. These are your preferences." >&2; exit 1; }

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

DRY_RUN=0
FORCE=0
ACTION="set"
for arg in "$@"; do
  case "$arg" in
    --list)    ACTION="list" ;;
    --dry-run) DRY_RUN=1 ;;
    --force)   FORCE=1 ;;
    -h|--help) sed -n "2,/^set -euo/p" "$0" | sed '$d'; exit 0 ;;
    *) die "unknown option: $arg" ;;
  esac
done

command -v xdg-mime >/dev/null || die "xdg-mime not found. sudo apt install xdg-utils"

# ---------------------------------------------------------------------------
# The table: MIME type, then desktop IDs in order of preference.
#
# Keep the candidate lists honest — every entry should be something this
# repo can actually install, or something you plausibly have.
# ---------------------------------------------------------------------------
MAP=(
  "application/pdf|org.pwmt.zathura.desktop evince.desktop"
  "application/epub+zip|org.pwmt.zathura.desktop"
  "application/postscript|org.pwmt.zathura.desktop"

  "image/png|imv.desktop org.gnome.eog.desktop"
  "image/jpeg|imv.desktop org.gnome.eog.desktop"
  "image/gif|imv.desktop"
  "image/webp|imv.desktop"
  "image/tiff|imv.desktop"
  "image/bmp|imv.desktop"
  "image/svg+xml|org.inkscape.Inkscape.desktop imv.desktop"

  "video/mp4|mpv.desktop"
  "video/x-matroska|mpv.desktop"
  "video/webm|mpv.desktop"
  "video/quicktime|mpv.desktop"
  "video/x-msvideo|mpv.desktop"

  "audio/mpeg|mpv.desktop"
  "audio/flac|mpv.desktop"
  "audio/ogg|mpv.desktop"
  "audio/x-wav|mpv.desktop"

  "text/plain|emacsclient.desktop emacs.desktop"
  "text/markdown|emacsclient.desktop emacs.desktop"

  "text/html|mullvad-browser.desktop firefox-esr.desktop firefox.desktop"
  "x-scheme-handler/http|mullvad-browser.desktop firefox-esr.desktop firefox.desktop"
  "x-scheme-handler/https|mullvad-browser.desktop firefox-esr.desktop firefox.desktop"

  "inode/directory|thunar.desktop org.gnome.Nautilus.desktop"
)

# ---------------------------------------------------------------------------
# Is this desktop ID installed?
#
# Search the same directories the desktop spec does, so a locally-installed
# entry in ~/.local/share/applications — an AppImage integrated by
# appimage-manage, say — counts just as much as a packaged one.
# ---------------------------------------------------------------------------
desktop_dirs() {
  local d
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  for d in $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
    printf '%s\n' "$d/applications"
  done
}

# Has a preference been recorded for this type? Both files count — the
# second is deprecated but still honoured, and still overrides the first.
has_preference() {
  local mime="$1" f
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" \
           "${XDG_DATA_HOME:-$HOME/.local/share}/applications/mimeapps.list"; do
    [[ -f "$f" ]] || continue
    grep -q "^[[:space:]]*${mime}[[:space:]]*=" "$f" && return 0
  done
  return 1
}

have_desktop() {
  local id="$1" dir
  while IFS= read -r dir; do
    [[ -f "$dir/$id" ]] && return 0
  done < <(desktop_dirs)
  return 1
}

# ---------------------------------------------------------------------------
if [[ "$ACTION" == "list" ]]; then
  say "Current defaults"
  for row in "${MAP[@]}"; do
    mime="${row%%|*}"
    current="$(xdg-mime query default "$mime" 2>/dev/null || true)"
    printf '  %-26s %s\n' "$mime" "${current:-<unset>}"
  done
  echo
  echo "  Stored in: ${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
  exit 0
fi

say "Setting defaults"
[[ $DRY_RUN -eq 1 ]] && warn "Dry run — nothing will be written."

CHANGED=0
SKIPPED=()

for row in "${MAP[@]}"; do
  mime="${row%%|*}"
  candidates="${row#*|}"

  chosen=""
  for id in $candidates; do
    if have_desktop "$id"; then chosen="$id"; break; fi
  done

  if [[ -z "$chosen" ]]; then
    SKIPPED+=("$mime")
    continue
  fi

  current="$(xdg-mime query default "$mime" 2>/dev/null || true)"
  if [[ "$current" == "$chosen" ]]; then
    printf '  ok       %-26s %s\n' "$mime" "$chosen"
    continue
  fi

  if [[ $FORCE -eq 0 ]] && has_preference "$mime"; then
    printf '  keep     %-26s %s  (yours; --force to change)\n' "$mime" "${current:-<unset>}"
    continue
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '  would    %-26s %s -> %s\n' "$mime" "${current:-<unset>}" "$chosen"
    continue
  fi

  xdg-mime default "$chosen" "$mime"

  # Verify rather than assume: xdg-mime exits 0 for a desktop ID that does
  # not resolve, and you find out later when the file opens in nothing.
  verify="$(xdg-mime query default "$mime" 2>/dev/null || true)"
  if [[ "$verify" == "$chosen" ]]; then
    printf '  set      %-26s %s -> %s\n' "$mime" "${current:-<unset>}" "$chosen"
    CHANGED=$((CHANGED + 1))
  else
    warn "  $mime did not take: wanted $chosen, got ${verify:-<unset>}"
  fi
done

if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  echo
  warn "No installed application for: ${SKIPPED[*]}"
  warn "That is fine if you do not want one — ./extras docs media desktop adds the usual suspects."
fi

[[ $DRY_RUN -eq 1 ]] && exit 0

# Keep the cache in step with what was just written.
if command -v update-desktop-database >/dev/null; then
  update-desktop-database "${XDG_DATA_HOME:-$HOME/.local/share}/applications" 2>/dev/null || true
fi

say "Done — $CHANGED changed."
cat <<'EOF'

  Check any single type:
    xdg-mime query default application/pdf
    xdg-open some.pdf

  If a file still opens in the wrong application, the culprit is usually a
  SECOND preference file. Applications write these too:

    ~/.config/mimeapps.list                    <- this script writes here
    ~/.local/share/applications/mimeapps.list  <- deprecated, still honoured

  The second one wins for anything it mentions. Delete stale entries there
  rather than fighting them from here.

  If ~/.config/mimeapps.list is a stow symlink into your dotfiles repo, note
  that xdg-mime writes straight through it — your preferences land in the
  repo, which may be exactly what you want, but commit them deliberately.

EOF
