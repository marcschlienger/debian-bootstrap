#!/usr/bin/env bash
#
# appimage-manage — integrate AppImages into a Sway desktop properly.
#
# AppImages are self-contained but not self-integrating: nothing puts them
# on your PATH, in fuzzel, or in your icon theme. This script does that by
# extracting the .desktop file and icon that are already inside the AppImage,
# rather than hand-writing approximations of them.
#
# Layout it uses:
#   ~/.local/lib/appimages/<name>.AppImage      the binary
#   ~/.local/bin/<name>                         symlink, so it's on PATH
#   ~/.local/share/applications/<name>.desktop  launcher entry
#   ~/.local/share/icons/hicolor/...            icon
#
# Usage:
#   ./appimage-manage install ~/Downloads/Cryptomator-1.x.AppImage
#   ./appimage-manage install ~/Downloads/foo.AppImage --name foo
#   ./appimage-manage list
#   ./appimage-manage update ~/Downloads/Cryptomator-1.y.AppImage cryptomator
#   ./appimage-manage remove cryptomator
#   ./appimage-manage check          # verify FUSE prerequisites
#
set -euo pipefail

APP_DIR="${HOME}/.local/lib/appimages"
BIN_DIR="${HOME}/.local/bin"
DESKTOP_DIR="${HOME}/.local/share/applications"
ICON_DIR="${HOME}/.local/share/icons/hicolor"

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] && die "Run as your normal user, not root."

WORKDIR=""
# Must always return 0: the EXIT trap's status becomes the script's exit
# status, so a bare [[ ]] test here makes every clean run exit 1.
cleanup() {
  if [[ -n "$WORKDIR" && -d "$WORKDIR" ]]; then rm -rf "$WORKDIR"; fi
  return 0
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# FUSE prerequisites
#
# THE classic AppImage failure on modern Debian: most AppImages in the wild
# are type-2, built against libfuse2. Debian Trixie ships fuse3 by default and
# libfuse2 is a separate package (libfuse2t64 after the 64-bit time_t
# transition). Without it you get:
#
#   dlopen(): error loading libfuse.so.2
#   AppImages require FUSE to run.
#
# which reads like the AppImage is broken. It isn't.
# ---------------------------------------------------------------------------
check_fuse() {
  local ok=1

  if ! command -v fusermount3 >/dev/null && ! command -v fusermount >/dev/null; then
    warn "No fusermount found. Install: sudo apt install fuse3"
    ok=0
  fi

  if ! ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2'; then
    warn "libfuse2 is NOT present. Most AppImages will refuse to start."
    warn "Install it:  sudo apt install libfuse2t64"
    warn "(package is libfuse2 on older releases)"
    ok=0
  fi

  if ! grep -qE '^user_allow_other' /etc/fuse.conf 2>/dev/null; then
    : # not required for AppImages, only noted for completeness
  fi

  if [[ $ok -eq 1 ]]; then
    say "FUSE prerequisites look fine."
  else
    cat <<'EOF'

  Workaround if you'd rather not install libfuse2 — every AppImage supports
  running without FUSE by self-extracting to a temp dir:

      ./Foo.AppImage --appimage-extract-and-run

  It's slower to start and uses disk in /tmp, but it always works. This
  script falls back to it automatically when libfuse2 is missing.

EOF
  fi

  return $((1 - ok))
}

have_fuse2() { ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2'; }

# ---------------------------------------------------------------------------
install_appimage() {
  local src="$1" forced_name="${2:-}"

  [[ -f "$src" ]] || die "Not found: $src"

  WORKDIR="$(mktemp -d)"

  # Work on a copy: --appimage-extract executes the file, so it must be
  # executable, and the download directory may not permit chmod.
  cp "$src" "$WORKDIR/src.AppImage"
  chmod +x "$WORKDIR/src.AppImage"
  src="$WORKDIR/src.AppImage"

  say "Extracting metadata from the AppImage"
  ( cd "$WORKDIR" && "$src" --appimage-extract >/dev/null 2>&1 ) \
    || die "Extraction failed. If this AppImage is not type-2, integrate it by hand."

  local root="$WORKDIR/squashfs-root"
  [[ -d "$root" ]] || die "No squashfs-root produced"

  # The .desktop file inside tells us the real name, icon and WM class.
  local desktop
  desktop="$(find "$root" -maxdepth 1 -name '*.desktop' | head -1)"
  [[ -n "$desktop" ]] || die "No .desktop file inside the AppImage"

  local name
  if [[ -n "$forced_name" ]]; then
    name="$forced_name"
  else
    name="$(basename "$desktop" .desktop)"
  fi
  # Normalise: lowercase, no spaces.
  name="$(echo "$name" | tr '[:upper:] ' '[:lower:]-')"

  say "Installing as: $name"

  mkdir -p "$APP_DIR" "$BIN_DIR" "$DESKTOP_DIR"

  local target="$APP_DIR/${name}.AppImage"
  cp "$src" "$target"
  chmod +x "$target"

  # Symlink onto PATH.
  ln -sf "$target" "$BIN_DIR/$name"

  # ---- icon -------------------------------------------------------------
  # .DirIcon is the canonical icon; it's usually a symlink into usr/share.
  local icon_name
  icon_name="$(grep -m1 '^Icon=' "$desktop" | cut -d= -f2- || echo "$name")"

  local installed_icon=0
  # Prefer properly-sized theme icons if present.
  if [[ -d "$root/usr/share/icons/hicolor" ]]; then
    while IFS= read -r -d '' f; do
      local rel="${f#"$root"/usr/share/icons/hicolor/}"
      mkdir -p "$ICON_DIR/$(dirname "$rel")"
      cp "$f" "$ICON_DIR/$rel"
      installed_icon=1
    done < <(find "$root/usr/share/icons/hicolor" -type f -print0)
  fi

  if [[ $installed_icon -eq 0 && -e "$root/.DirIcon" ]]; then
    mkdir -p "$ICON_DIR/256x256/apps"
    cp -L "$root/.DirIcon" "$ICON_DIR/256x256/apps/${icon_name}.png"
    installed_icon=1
  fi

  [[ $installed_icon -eq 1 ]] || warn "No icon found; launcher will show a generic one"

  # ---- desktop entry ----------------------------------------------------
  # Rewrite Exec to the absolute path, preserving field codes (%U, %F...).
  local exec_cmd="$target"
  if ! have_fuse2; then
    warn "libfuse2 missing — using --appimage-extract-and-run in the Exec line"
    exec_cmd="$target --appimage-extract-and-run"
  fi

  sed -E \
    -e "s|^Exec=[^ ]*(.*)|Exec=${exec_cmd}\1|" \
    -e "s|^TryExec=.*|TryExec=${target}|" \
    "$desktop" > "$DESKTOP_DIR/${name}.desktop"

  # Record provenance so `list` and `update` can do something sensible.
  if ! grep -q '^X-AppImage-Managed=' "$DESKTOP_DIR/${name}.desktop"; then
    echo "X-AppImage-Managed=appimage-manage" >> "$DESKTOP_DIR/${name}.desktop"
  fi

  update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  gtk-update-icon-cache -f -t "$ICON_DIR" 2>/dev/null || true

  say "Installed"
  cat <<EOF

  Binary:   $target
  On PATH:  $BIN_DIR/$name
  Launcher: $DESKTOP_DIR/${name}.desktop

  fuzzel will pick it up immediately — it reads the same XDG directories.
  Confirm ~/.local/bin is on your PATH (Debian's ~/.profile adds it only if
  the directory existed at login, so a fresh install may need a re-login).

EOF

  # Sway window rule hint, using the real WM class from the original entry.
  local wmclass
  wmclass="$(grep -m1 '^StartupWMClass=' "$desktop" | cut -d= -f2- || true)"
  if [[ -n "$wmclass" ]]; then
    echo "  Sway window rule, if you want one:"
    echo "    for_window [class=\"$wmclass\"] floating enable"
    echo
    echo "  (AppImages are usually X11/XWayland, so match on class, not app_id.)"
    echo
  fi
}

# ---------------------------------------------------------------------------
list_appimages() {
  say "Managed AppImages in $APP_DIR"
  if [[ ! -d "$APP_DIR" ]] || [[ -z "$(ls -A "$APP_DIR" 2>/dev/null)" ]]; then
    echo "  (none)"
    return
  fi
  local found=0
  for f in "$APP_DIR"/*.AppImage; do
    [[ -e "$f" ]] || continue      # unmatched glob expands to itself
    found=1
    local n
    n="$(basename "$f" .AppImage)"
    printf '  %-20s %8s  %s\n' \
      "$n" \
      "$(du -h "$f" | cut -f1)" \
      "$(date -r "$f" '+%Y-%m-%d')"
  done
  if [[ $found -eq 0 ]]; then
    echo "  (none)"
    return
  fi
  echo
  echo "  Updates are manual. Check upstream, then:"
  echo "    $0 update <new-file> <name>"
}

# ---------------------------------------------------------------------------
remove_appimage() {
  local name="$1"
  [[ -f "$APP_DIR/${name}.AppImage" ]] || die "Not managed: $name"

  say "Removing $name"
  rm -f "$APP_DIR/${name}.AppImage" "$BIN_DIR/$name" "$DESKTOP_DIR/${name}.desktop"
  update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  warn "Icons in $ICON_DIR are left in place (they're shared by theme path)."
  say "Done."
}

# ---------------------------------------------------------------------------
case "${1:-}" in
  install)
    [[ -n "${2:-}" ]] || die "install needs a path to an .AppImage"
    check_fuse || true
    NAME=""
    if [[ "${3:-}" == "--name" ]]; then NAME="${4:-}"; fi
    install_appimage "$2" "$NAME"
    ;;
  update)
    [[ -n "${2:-}" && -n "${3:-}" ]] || die "update needs <new-file> <name>"
    say "Replacing $3"
    install_appimage "$2" "$3"
    ;;
  remove)  [[ -n "${2:-}" ]] || die "remove needs a name"; remove_appimage "$2" ;;
  list)    list_appimages ;;
  check)   check_fuse ;;
  *)       sed -n "2,/^set -euo/p" "$0" | sed '$d'; exit 1 ;;
esac
