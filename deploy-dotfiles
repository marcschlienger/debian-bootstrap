#!/usr/bin/env bash
#
# deploy-dotfiles — clone the dotfiles repo to ~/.dotfiles and stow it.
#
# GNU Stow refuses to overwrite a real file, and a fresh Debian install ships
# real files at exactly the paths dotfiles want: ~/.bashrc, ~/.profile,
# ~/.bash_logout. Stow's answer is to abort the whole package, which reads
# like the package is broken. This script backs those files up first, so
# stowing is a normal operation rather than a fight.
#
# Idempotent: safe to re-run after adding files to a package, after editing
# the repo, or after a partial failure.
#
# Usage:
#   ./deploy-dotfiles                  # clone or update, then stow everything
#   ./deploy-dotfiles sway kitty zsh   # only these packages
#   ./deploy-dotfiles --list           # what the repo contains
#   ./deploy-dotfiles --dry-run        # show what stow would do, change nothing
#   ./deploy-dotfiles --delete zsh     # unstow a package
#   ./deploy-dotfiles --no-pull        # do not touch an existing checkout
#
# The repo is overridable, since these are one person's dotfiles:
#   DOTFILES_REPO=https://github.com/you/dotfiles.git ./deploy-dotfiles
#
set -euo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/marcschlienger/dotfiles.git}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
STAMP="$(date +%Y%m%d%H%M%S)"

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] && die "Run as your normal user, not root. These are your dotfiles."

DRY_RUN=0
NO_PULL=0
ACTION="stow"
SELECTED=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)      ACTION="list" ;;
    --dry-run)   DRY_RUN=1 ;;
    --no-pull)   NO_PULL=1 ;;
    --delete)    ACTION="delete" ;;
    --repo)      DOTFILES_REPO="${2:-}"
                 [[ -n "$DOTFILES_REPO" ]] || die "--repo needs a URL"
                 shift ;;
    -h|--help)   sed -n "2,/^set -euo/p" "$0" | sed '$d'; exit 0 ;;
    -*)          die "unknown option: $1" ;;
    *)           SELECTED+=("$1") ;;
  esac
  shift
done

command -v stow >/dev/null || die "stow is not installed. sudo apt install stow"
command -v git  >/dev/null || die "git is not installed. sudo apt install git"

# ---------------------------------------------------------------------------
# 1. Clone, or update in place
# ---------------------------------------------------------------------------
if [[ ! -d "$DOTFILES_DIR" ]]; then
  say "Cloning $DOTFILES_REPO to $DOTFILES_DIR"
  # HTTPS, not SSH: a freshly installed machine has no key on GitHub yet, and
  # an SSH clone here fails with a permission error that looks like the repo
  # is private. Switch the remote to SSH later if you want to push.
  git clone "$DOTFILES_REPO" "$DOTFILES_DIR" || die "Clone failed"
elif [[ ! -d "$DOTFILES_DIR/.git" ]]; then
  die "$DOTFILES_DIR exists but is not a git checkout. Move it aside first."
elif [[ $NO_PULL -eq 1 ]]; then
  say "Using the existing checkout in $DOTFILES_DIR (--no-pull)"
else
  say "Updating $DOTFILES_DIR"
  # --ff-only so local edits are never silently merged away; if this fails,
  # you have work in there to deal with yourself.
  git -C "$DOTFILES_DIR" pull --ff-only \
    || warn "Could not fast-forward — local changes? Continuing with what is on disk."
fi

# ---------------------------------------------------------------------------
# 2. Packages
#
# A stow package is a top-level directory. Dotted directories (.git,
# .github) are repo infrastructure, not packages.
# ---------------------------------------------------------------------------
ALL_PKGS=()
while IFS= read -r d; do
  ALL_PKGS+=("$(basename "$d")")
done < <(find "$DOTFILES_DIR" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sort)

[[ ${#ALL_PKGS[@]} -gt 0 ]] || die "No stow packages found in $DOTFILES_DIR"

# Is every file in this package reachable at its target path, and does it
# resolve back to the file in the repo?
#
# Resolving paths rather than testing for symlinks is deliberate: stow FOLDS
# directories, so a fully-stowed package can be a single ~/.config/kitty
# symlink, and the individual files under it are then plain files as far as
# `test -L` is concerned.
pkg_stowed() {
  local pkgdir="$DOTFILES_DIR/$1" rel target any=0
  while IFS= read -r -d '' f; do
    any=1
    rel="${f#"$pkgdir"/}"
    target="$HOME/$rel"
    [[ -e "$target" ]] || return 1
    [[ "$(readlink -f "$target" 2>/dev/null || true)" \
       == "$(readlink -f "$f" 2>/dev/null || true)" ]] || return 1
  done < <(find "$pkgdir" \( -type f -o -type l \) -print0)
  [[ $any -eq 1 ]]
}

if [[ "$ACTION" == "list" ]]; then
  say "Packages in $DOTFILES_DIR"
  for p in "${ALL_PKGS[@]}"; do
    if pkg_stowed "$p"; then
      printf '  %-12s stowed\n' "$p"
    else
      printf '  %-12s not stowed\n' "$p"
    fi
  done
  exit 0
fi

if [[ ${#SELECTED[@]} -eq 0 ]]; then
  SELECTED=("${ALL_PKGS[@]}")
else
  for p in "${SELECTED[@]}"; do
    case " ${ALL_PKGS[*]} " in
      *" $p "*) ;;
      *) die "no such package: $p (try --list)" ;;
    esac
  done
fi

# ---------------------------------------------------------------------------
# 3. Unstow
# ---------------------------------------------------------------------------
if [[ "$ACTION" == "delete" ]]; then
  say "Unstowing: ${SELECTED[*]}"
  [[ $DRY_RUN -eq 1 ]] && say "Dry run"
  for p in "${SELECTED[@]}"; do
    if [[ $DRY_RUN -eq 1 ]]; then
      stow -d "$DOTFILES_DIR" -t "$HOME" -n -v --delete "$p" 2>&1 | sed 's/^/  /'
    else
      stow -d "$DOTFILES_DIR" -t "$HOME" --delete "$p"
      echo "  removed $p"
    fi
  done
  say "Done. Backups made by earlier runs are left alone — look for *.pre-stow.*"
  exit 0
fi

# ---------------------------------------------------------------------------
# 4. Clear the way
#
# Work out every target path a package owns and move any REAL file already
# sitting there out of the way. Parsing stow's conflict output would be the
# obvious alternative, but the wording differs between stow versions; walking
# the package is deterministic.
#
# A symlink that already points into the dotfiles repo is stow's own work and
# is left alone. A symlink pointing anywhere else is somebody else's and gets
# the same backup treatment as a real file.
# ---------------------------------------------------------------------------
BACKED_UP=()

clear_conflicts() {
  local pkgdir="$DOTFILES_DIR/$1" rel target resolved
  while IFS= read -r -d '' f; do
    rel="${f#"$pkgdir"/}"
    target="$HOME/$rel"

    [[ -e "$target" || -L "$target" ]] || continue

    # Already ours? Compare RESOLVED paths rather than testing for a symlink.
    # Stow folds directories, so in an already-stowed package the target is a
    # plain file reached through a symlinked parent — and moving that renames
    # the file inside your dotfiles repo, which shows up as `git status`
    # reporting your own configs deleted. Re-running this script must be a
    # no-op, not vandalism.
    resolved="$(readlink -f "$target" 2>/dev/null || true)"
    [[ -n "$resolved" && "$resolved" == "$(readlink -f "$f" 2>/dev/null || true)" ]] \
      && continue

    if [[ $DRY_RUN -eq 1 ]]; then
      echo "  would back up: $target"
      continue
    fi

    mv "$target" "${target}.pre-stow.${STAMP}"
    BACKED_UP+=("${target}.pre-stow.${STAMP}")
    echo "  backed up: $target"
  done < <(find "$pkgdir" \( -type f -o -type l \) -print0)
}

say "Preparing: ${SELECTED[*]}"
for p in "${SELECTED[@]}"; do
  clear_conflicts "$p"
done

# ---------------------------------------------------------------------------
# 5. Stow
#
# --restow (delete then stow) rather than plain stow: it is the idempotent
# form, and it cleans up links to files you have since removed from a package.
# ---------------------------------------------------------------------------
if [[ $DRY_RUN -eq 1 ]]; then
  say "Dry run — what stow would do"
  for p in "${SELECTED[@]}"; do
    printf '\n  %s:\n' "$p"
    stow -d "$DOTFILES_DIR" -t "$HOME" -n -v --restow "$p" 2>&1 | sed 's/^/    /'
  done
  say "Nothing was changed."
  exit 0
fi

say "Stowing"
FAILED=()
for p in "${SELECTED[@]}"; do
  if stow -d "$DOTFILES_DIR" -t "$HOME" --restow "$p" 2>/dev/null; then
    echo "  $p"
  else
    FAILED+=("$p")
    warn "$p failed — rerun for the reason:  stow -d $DOTFILES_DIR -t $HOME --restow $p"
  fi
done

# ---------------------------------------------------------------------------
say "Done."

if [[ ${#BACKED_UP[@]} -gt 0 ]]; then
  echo
  echo "  Files moved aside (delete them once you are happy):"
  printf '    %s\n' "${BACKED_UP[@]}"

  # The ordering trap. `bootstrap-sway --tty-autostart` appends the tty1 exec
  # to ~/.profile, and phase 3 runs that BEFORE this script. If a dotfiles
  # package then takes ownership of that file, the appended block leaves with
  # the backup and sway stops starting on tty1 — silently, since nothing
  # errors and the file it was in still exists under another name.
  for b in "${BACKED_UP[@]}"; do
    orig="${b%.pre-stow.*}"
    if grep -q 'start-sway' "$b" 2>/dev/null && ! grep -q 'start-sway' "$orig" 2>/dev/null; then
      echo
      warn "$(basename "$orig") contained the sway tty1 autostart; the stowed version does not."
      warn "Sway will not start on tty1 until you put this in that file in your dotfiles repo:"
      cat <<'EOF'

    # Start sway on tty1
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_VTNR:-}" = "1" ]; then
      exec "$HOME/.local/bin/start-sway"
    fi
EOF
    fi
  done
fi

[[ ${#FAILED[@]} -gt 0 ]] && warn "Failed packages: ${FAILED[*]}"

cat <<'EOF'

  Two things that interact with the rest of this repo:

  1. Your sway config must include the drop-in bootstrap-sway wrote, or
     screen sharing breaks with no error:

       include ~/.config/sway/config.d/*

  2. If a package owns ~/.profile or ~/.zprofile, the tty1 sway autostart
     belongs IN THE REPO, not appended to the symlink. `bootstrap-sway
     --tty-autostart` and `extras shell` both detect this and refuse to
     write through a stow symlink rather than editing your dotfiles behind
     your back. Add it yourself:

       # Start sway on tty1
       if [ -z "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_VTNR:-}" = "1" ]; then
         exec "$HOME/.local/bin/start-sway"
       fi

EOF
