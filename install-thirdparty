#!/usr/bin/env bash
#
# install-thirdparty — applications not available in Debian's archive.
#
# Each of these uses a different distribution channel, and the choice of
# channel matters more than usual. Rationale is documented per app.
#
# Usage:
#   ./install-thirdparty --list
#   ./install-thirdparty mullvad-browser cryptomator
#   ./install-thirdparty --all
#
set -euo pipefail

[[ $EUID -eq 0 ]] && { echo "Run as your normal user, not root." >&2; exit 1; }

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

APPS=(tailscale mullvad-browser cryptomator yazi obsidian claude-code codex)

# ---------------------------------------------------------------------------
# First installable name from a list.
#
# Library packages carry their SONAME, so the name changes out from under you
# between releases: libfuse3-3 in bookworm, libfuse3-4 in trixie; libfuse2
# became libfuse2t64 in the 64-bit time_t transition. Hardcoding one means
# the script breaks on a release it was not written against, and apt's error
# reads like the package is missing rather than misnamed.
#
# `apt-cache show` is not a good enough test: it succeeds for names that only
# appear in some dependency list. policy tells us apt could really install it.
# ---------------------------------------------------------------------------
apt_candidate() {
  local p cand
  for p in "$@"; do
    cand="$(apt-cache policy "$p" 2>/dev/null | awk -F': ' '/Candidate:/{print $2}')"
    if [[ -n "$cand" && "$cand" != "(none)" ]]; then printf '%s\n' "$p"; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# Fetch a binary file to a path, byte for byte.
#
# Signing keys are BINARY gpg keyrings and must never pass through a shell
# variable: command substitution strips NUL bytes and trailing newlines, and
# printf then adds a newline that was not there. What lands on disk is not
# what was downloaded, apt cannot verify the signature, and it reports
# "the repository is not signed" — which reads like the vendor's problem and
# is entirely ours.
# ---------------------------------------------------------------------------
fetch_to() { curl -fsSL -o "$2" "$1"; }

# A 404 page is still a file. A binary OpenPGP public-key packet starts with
# 0x98, 0x99 (old format) or 0xc6 (new format); HTML starts with '<'.
looks_like_keyring() {
  [[ -s "$1" ]] || return 1
  local magic
  magic="$(od -An -N1 -tx1 "$1" | tr -d ' \n')"
  case "$magic" in
    98|99|c6) return 0 ;;
    *)        return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
ensure_flatpak() {
  if ! command -v flatpak >/dev/null; then
    say "Installing flatpak"
    sudo apt-get install -y flatpak
    # Verify rather than assume: if apt failed, the next command's
    # "flatpak: command not found" is a confusing way to find out.
    command -v flatpak >/dev/null || die "flatpak install failed; see apt output above"
  fi
  sudo flatpak remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo
}

# ---------------------------------------------------------------------------
# Tailscale — official Debian repository, keyed per release codename.
#
# MagicDNS note: tailscaled needs a DNS manager. With systemd-resolved present
# it uses the proper split-DNS API; without it, it rewrites /etc/resolv.conf
# directly, which works but fights NetworkManager. A minimal Debian install
# has NetworkManager but often NOT systemd-resolved, so we offer to add it.
# ---------------------------------------------------------------------------
install_tailscale() {
  local codename
  codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
  [[ -n "$codename" ]] || die "Could not determine Debian codename"

  if [[ ! -f /etc/apt/sources.list.d/tailscale.list ]]; then
    say "Adding Tailscale repository for Debian $codename"

    local tmpkey tmplist base="https://pkgs.tailscale.com/stable/debian"
    tmpkey="$(mktemp)"  || die "mktemp failed"
    tmplist="$(mktemp)" || { rm -f "$tmpkey"; die "mktemp failed"; }
    # shellcheck disable=SC2064
    trap "rm -f '$tmpkey' '$tmplist'" RETURN

    # Try the real fetch rather than a separate HEAD probe: some CDNs answer
    # HEAD differently from GET, which would make us wrongly report the
    # release as unpublished.
    if ! fetch_to "${base}/${codename}.noarmor.gpg" "$tmpkey"; then
      warn "No Tailscale package repository for '$codename'."
      warn "This happens for a short while after a new Debian release."
      read -rp "Codename to use instead (e.g. bookworm), blank to abort: " codename || true
      [[ -n "${codename:-}" ]] || die "Aborted."
      fetch_to "${base}/${codename}.noarmor.gpg" "$tmpkey" \
        || die "No repository for '$codename' either. Check ${base}/"
    fi

    # Check the key before apt has to. Installing a bad one leaves you
    # debugging "the repository is not signed" instead of a failed download.
    looks_like_keyring "$tmpkey" \
      || die "What was downloaded is not a GPG keyring. Check ${base}/${codename}.noarmor.gpg"

    sudo install -m 0644 "$tmpkey" /usr/share/keyrings/tailscale-archive-keyring.gpg

    # Same treatment for the sources list: piping curl into tee truncates the
    # file first, so a failed fetch would leave an empty tailscale.list — and
    # the guard above would then report the repo as "already configured" on
    # every future run.
    fetch_to "${base}/${codename}.tailscale-keyring.list" "$tmplist" \
      || die "Could not fetch the Tailscale sources list"
    [[ -s "$tmplist" ]] || die "The Tailscale sources list downloaded empty."
    sudo install -m 0644 "$tmplist" /etc/apt/sources.list.d/tailscale.list

    sudo apt-get update
  else
    say "Tailscale repository already configured"
  fi

  say "Installing tailscale"
  sudo apt-get install -y tailscale

  if ! systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1 \
     || ! systemctl is-enabled systemd-resolved.service >/dev/null 2>&1; then
    cat <<'EOF'

  systemd-resolved is not active. Tailscale will fall back to rewriting
  /etc/resolv.conf, which works but conflicts with NetworkManager and makes
  MagicDNS unreliable. Installing it is strongly recommended.

EOF
    read -rp "Install and enable systemd-resolved? [Y/n] " r || true
    if [[ "${r:-y}" != [Nn]* ]]; then
      sudo apt-get install -y systemd-resolved
      sudo systemctl enable --now systemd-resolved
    fi
  fi

  # ---------------------------------------------------------------------------
  # Verify DNS before telling anyone to run `tailscale up`.
  #
  # `systemctl enable --now` can return without the service actually being up,
  # and installing systemd-resolved repoints /etc/resolv.conf at the stub
  # resolver on 127.0.0.53. If nothing is listening there, every lookup fails
  # while routing stays perfectly fine — ping works, nmtui looks healthy, no
  # name resolves. Observed on this exact path; a reboot fixed it, which is
  # what "the service was never running" looks like from the outside.
  #
  # It matters here specifically because `tailscale up` prints an auth URL you
  # have to open in a browser. Broken DNS at that moment means you cannot
  # complete the step the script is about to tell you to perform.
  # ---------------------------------------------------------------------------
  dns_works() {
    # getent goes through the system resolver, which is the thing under test
    # — unlike dig, which can be pointed elsewhere and would happily pass
    # while everything else on the machine still fails.
    #
    # curl is the fallback rather than the primary, but it must be a fallback
    # and not the only test: a check that reports "broken" because its own
    # tool is missing would block an install that was working fine.
    if command -v getent >/dev/null; then
      getent hosts deb.debian.org  >/dev/null 2>&1 && return 0
      getent hosts one.one.one.one >/dev/null 2>&1 && return 0
    fi
    if command -v curl >/dev/null; then
      curl -fsS --max-time 5 -o /dev/null https://deb.debian.org/ 2>/dev/null && return 0
    fi
    return 1
  }

  if ! command -v getent >/dev/null && ! command -v curl >/dev/null; then
    warn "No getent and no curl — cannot test name resolution, skipping the check."
  elif ! dns_works; then
    warn "Name resolution is not working right now."

    if systemctl list-unit-files systemd-resolved.service >/dev/null 2>&1 \
       && ! systemctl is-active --quiet systemd-resolved; then
      warn "systemd-resolved is installed but not running, and /etc/resolv.conf"
      warn "almost certainly points at its stub on 127.0.0.53 — so there is"
      warn "nothing listening where every lookup is being sent."
      r=""
      read -rp "Start it now? [Y/n] " r || true
      if [[ "${r:-y}" != [Nn]* ]]; then
        sudo systemctl enable --now systemd-resolved || warn "could not start it"
        sleep 1
      fi
    fi

    if dns_works; then
      say "Resolution is working now."
    else
      cat <<'EOF'

  STOPPING HERE. Tailscale is installed, but `tailscale up` prints a URL you
  must open in a browser, and no browser will resolve anything right now.

  Look at, in this order:

    systemctl is-active systemd-resolved
    resolvectl status | head -20
    cat /etc/resolv.conf
    nmcli device show | grep -i dns

  A stub at 127.0.0.53 with a dead systemd-resolved is the usual cause, and
  a reboot clears it. Then re-run this script.

  Or ignore all of it for now: the auth URL opens on any device. Run
  `sudo tailscale up --operator=$USER` here, and open the URL it prints on
  your phone. Nothing needs to resolve on this machine for that to work.

EOF
      exit 1
    fi
  fi

  sudo systemctl enable --now tailscaled

  # There are reports on Trixie of the daemon not coming up after apt install
  # (missing /etc/default/tailscaled), which makes `tailscale up` fail with a
  # confusing "it doesn't appear to be running". Check rather than assume.
  if ! systemctl is-active --quiet tailscaled; then
    warn "tailscaled did not start. Checking the usual Trixie cause..."
    if [[ ! -f /etc/default/tailscaled ]]; then
      warn "/etc/default/tailscaled is missing — creating a default."
      echo 'FLAGS=""' | sudo tee /etc/default/tailscaled >/dev/null
      sudo systemctl restart tailscaled || true
    fi
    systemctl is-active --quiet tailscaled \
      || warn "Still not running. Check: journalctl -u tailscaled -n 50"
  fi

  cat <<'EOF'

  Now authenticate. For a laptop:

    sudo tailscale up --operator=$USER

  --operator lets you run `tailscale status/up/down` without sudo afterwards.

  Worth considering for your setup:

  - Tailscale SSH to your two Ubuntu servers, no keys to manage:
      sudo tailscale up --operator=$USER --ssh
    Then from the laptop:  ssh <user>@<server-tailscale-name>

  - MagicDNS gives each machine a stable name. Check it resolves:
      tailscale status
      tailscale ping <server>

  - There is no official Linux GUI. The CLI is the interface; if you want it
    in waybar, a custom module running `tailscale status --json` works well.

EOF

  cat <<'EOF'
  Reaching your servers and the services on them:

  If a machine runs Tailscale, it is reachable by its MagicDNS name as soon
  as it is up. Nothing else to configure:

    tailscale status                 # see the tailnet
    ssh user@myserver                # MagicDNS name, no IP, no VPN toggle
    curl http://myserver:8080        # a service on that machine

  If you need to reach devices on the server's LAN that do NOT run Tailscale
  (a NAS, a printer, a router UI, containers on a bridge network), that is a
  SUBNET ROUTER, not an exit node — different feature, and the one you
  probably want:

    On the server:
      sudo tailscale up --advertise-routes=192.168.1.0/24
      # then approve the route in the admin console

    On this laptop:
      sudo tailscale up --accept-routes

  --accept-routes is NOT the default on Linux. Without it the route is
  advertised and approved and still does not work, with no error anywhere.
  This is the single most common "subnet routing is broken" cause.

  Exit nodes (routing ALL internet traffic through a node) are a separate
  feature you do not need for this. See the guide if you ever want it.

EOF
}

# ---------------------------------------------------------------------------
# Mullvad — official Debian repository.
#
# This is the best case: signed, native packages, updates via normal apt.
# Mullvad self-hosts a repo covering Debian, Ubuntu and Fedora, so there is
# no reason to use the standalone tarball or Flathub build here.
# ---------------------------------------------------------------------------
add_mullvad_repo() {
  if [[ -f /etc/apt/sources.list.d/mullvad.list ]] \
     || [[ -f /etc/apt/sources.list.d/mullvad.sources ]]; then
    say "Mullvad repository already configured"
    return
  fi

  say "Adding Mullvad repository"

  # This key is ASCII-armored, so it survives a pipe — but `curl -o` creates
  # the destination before the transfer, so a failed download still leaves a
  # truncated keyring behind, and apt's complaint for that is the same
  # unhelpful "repository is not signed". Stage it, then install it.
  local tmpkey
  tmpkey="$(mktemp)" || die "mktemp failed"
  # shellcheck disable=SC2064
  trap "rm -f '$tmpkey'" RETURN

  fetch_to https://repository.mullvad.net/deb/mullvad-keyring.asc "$tmpkey" \
    || die "Could not fetch Mullvad signing key"
  grep -q 'BEGIN PGP PUBLIC KEY BLOCK' "$tmpkey" \
    || die "What was downloaded is not a PGP public key block."

  sudo install -m 0644 "$tmpkey" /usr/share/keyrings/mullvad-keyring.asc

  echo "deb [signed-by=/usr/share/keyrings/mullvad-keyring.asc arch=$(dpkg --print-architecture)] https://repository.mullvad.net/deb/stable stable main" \
    | sudo tee /etc/apt/sources.list.d/mullvad.list >/dev/null

  sudo apt-get update
}

install_mullvad_browser() {
  add_mullvad_repo
  say "Installing mullvad-browser"
  sudo apt-get install -y mullvad-browser
  cat <<'EOF'

  Mullvad Browser is a hardened Firefox fork built with the Tor Project.
  Two things to know:

  - It intentionally resists fingerprinting, which includes reporting a
    standard window size. Letterboxing (grey bars) when tiling is expected
    behaviour, not a bug. If it bothers you, float it in sway:
      for_window [app_id="mullvad-browser"] floating enable

  - It has no VPN built in and is designed to be used with one. Installing
    the browser does not install or require the Mullvad VPN app.

EOF
}

# ---------------------------------------------------------------------------
# Resolve a Cryptomator release asset without hardcoding a version.
#
# Upstream's download page puts the version in the URL, which is why this
# script used to say "download it yourself and tell me the path". The
# releases API gives the current version instead, so nothing here rots.
#
# No jq: it is not installed on a minimal system, and this needs two fields.
# ---------------------------------------------------------------------------
gh_latest() { curl -fsSL "https://api.github.com/repos/$1/releases/latest" || true; }

json_asset_url() {  # $1 = release json, $2 = suffix to match
  printf '%s' "$1" \
    | grep -o "\"browser_download_url\"[[:space:]]*:[[:space:]]*\"[^\"]*${2}\"" \
    | head -1 | cut -d'"' -f4
}

json_tag() {
  printf '%s' "$1" | grep -o '"tag_name\"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | head -1 | cut -d'"' -f4
}

# Verify a detached signature, and do NOT quietly continue when it fails.
# A signature you cannot check is worth more as a stop than as a warning.
verify_detached() {
  local file="$1" sig="$2" out
  if ! command -v gpg >/dev/null; then
    warn "gpg is not installed, so the signature cannot be checked."
    warn "  sudo apt install gnupg"
  elif out="$(gpg --verify "$sig" "$file" 2>&1)"; then
    say "Signature verified"
    printf '%s\n' "$out" | sed 's/^/    /'
    return 0
  else
    warn "Signature NOT verified:"
    printf '%s\n' "$out" | sed 's/^/    /'
    echo
    echo "  If it says 'No public key', you do not have Cryptomator's key yet."
    echo "  Take the fingerprint from https://cryptomator.org/downloads/ and"
    echo "  compare it before importing — a key fetched to check a file it"
    echo "  signed proves nothing on its own."
    echo
  fi
  local r=""
  read -rp "Continue with an unverified file? [y/N] " r || true
  [[ "${r:-}" == [Yy]* ]]
}

# ---------------------------------------------------------------------------
# Cryptomator — not in Debian's archive.
#
# Three channels, with a real tradeoff:
#
#   AppImage (upstream's recommended route)
#     + Full filesystem access, so vaults on external drives and mounted
#       partitions work.
#     + Uses system FUSE directly.
#     - No automatic updates; you re-download to upgrade.
#
#   Flatpak (Flathub, community-maintained)
#     + Automatic updates, sandboxed.
#     - Sandboxing restricts where vaults can live: users report removable
#       drives and other mount points not being visible.
#     - The manifest declares X11, so it runs under XWayland.
#
#   .deb from the release page (signed, but built for the Ubuntu PPA)
#     + Real package: dpkg owns it, launcher and icon come with it, no
#       libfuse2 dance.
#     - Versioned 0ppa1 and built against Ubuntu, so its dependencies are
#       not guaranteed to resolve on Debian stable. Try it; if apt starts
#       proposing removals, back out and take the AppImage.
#     - Not in a repository, so updates are still manual.
#
# Given you'll likely keep vaults in a Nextcloud folder under $HOME, any of
# them works. If a vault lives on an external disk, avoid the Flatpak.
# ---------------------------------------------------------------------------
install_cryptomator() {
  say "Cryptomator — choose a channel"
  cat <<'EOF'

  1) AppImage  — full filesystem access, manual updates  (upstream default)
  2) Flatpak   — auto updates, sandboxed, XWayland, limited to $HOME
  3) .deb      — real package, but built for the Ubuntu PPA

EOF
  read -rp "Which? [1/2/3] " choice || true
  case "${choice:-}" in
    3)
      local json tag deburl debpath dldir="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
      say "Looking up the latest Cryptomator release"
      json="$(gh_latest cryptomator/cryptomator)"
      [[ -n "$json" ]] || die "Could not reach the GitHub releases API."
      tag="$(json_tag "$json")"
      deburl="$(json_asset_url "$json" "_amd64\\.deb")"
      [[ -n "$deburl" ]] || die "No .deb asset in release ${tag:-latest}."

      mkdir -p "$dldir"
      debpath="$dldir/$(basename "$deburl")"
      say "Downloading ${tag:-latest}"
      fetch_to "$deburl" "$debpath" || die "Download failed"
      fetch_to "${deburl}.asc" "${debpath}.asc" \
        || warn "Could not fetch the signature"
      if [[ -f "${debpath}.asc" ]]; then
        verify_detached "$debpath" "${debpath}.asc" \
          || die "Stopping. The file is at $debpath if you want to check it yourself."
      fi

      # apt, not dpkg: it resolves dependencies instead of leaving you in a
      # half-configured state to untangle by hand.
      say "Installing $debpath"
      sudo apt-get install -y "$debpath" || {
        warn "apt refused it — most likely an Ubuntu-only dependency."
        warn "Nothing was changed. Re-run and choose 1 for the AppImage."
        exit 1
      }
      ;;
    2)
      ensure_flatpak
      say "Installing Cryptomator from Flathub"
      flatpak install -y flathub org.cryptomator.Cryptomator
      warn "Sandboxed: vaults outside \$HOME may not be visible."
      warn "Grant more access if needed:"
      warn "  flatpak override --user --filesystem=/media org.cryptomator.Cryptomator"
      ;;
    *)
      say "Installing FUSE support"
      # Just fuse3 — it already depends on the right libfuse3-N, and naming
      # that library here only bakes in a name with a release-long shelf life.
      sudo apt-get install -y fuse3

      say "Installing FUSE support for AppImages"
      # libfuse2 is what type-2 AppImages actually need; Debian defaults to
      # fuse3 only. Without this you get "dlopen(): error loading
      # libfuse.so.2", which looks like a broken download but isn't. Nothing
      # depends on it, so unlike libfuse3 it has to be named — resolved
      # rather than guessed.
      local libfuse2
      if libfuse2="$(apt_candidate libfuse2t64 libfuse2)"; then
        sudo apt-get install -y "$libfuse2"
      else
        warn "No libfuse2 package in this release (tried libfuse2t64, libfuse2)."
        warn "Type-2 AppImages will need --appimage-extract-and-run."
      fi

      # --- Fetch it, rather than asking for the path to a file you have had
      #     no opportunity to download.
      local arch aiarch json tag aiurl ascurl dldir aipath=""
      dldir="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"

      arch="$(dpkg --print-architecture 2>/dev/null || echo amd64)"
      case "$arch" in
        amd64) aiarch=x86_64 ;;
        arm64) aiarch=aarch64 ;;
        *)     aiarch="" ;;
      esac

      if [[ -z "$aiarch" ]]; then
        warn "No Cryptomator AppImage is published for '$arch'."
      else
        say "Looking up the latest Cryptomator release"
        json="$(gh_latest cryptomator/cryptomator)"
        if [[ -z "$json" ]]; then
          warn "Could not reach the GitHub releases API."
        else
          tag="$(json_tag "$json")"
          aiurl="$(json_asset_url "$json" "-${aiarch}\\.AppImage")"
          ascurl="$(json_asset_url "$json" "-${aiarch}\\.AppImage\\.asc")"
        fi

        if [[ -n "${aiurl:-}" ]]; then
          echo
          echo "  Latest release: ${tag:-unknown}"
          echo "  $aiurl"
          echo "  Downloads to:   $dldir"
          echo
          local r=""
          read -rp "Download it now? [Y/n] " r || true
          if [[ "${r:-y}" != [Nn]* ]]; then
            mkdir -p "$dldir"
            aipath="$dldir/$(basename "$aiurl")"
            if [[ -f "$aipath" ]]; then
              say "Already downloaded: $aipath"
            else
              fetch_to "$aiurl" "$aipath" || { warn "Download failed"; aipath=""; }
            fi

            if [[ -n "$aipath" && -n "${ascurl:-}" ]]; then
              fetch_to "$ascurl" "${aipath}.asc" \
                || warn "Could not fetch the signature"
              if [[ -f "${aipath}.asc" ]]; then
                verify_detached "$aipath" "${aipath}.asc" || {
                  warn "Stopping. The file is at $aipath if you want to check it yourself."
                  aipath=""
                }
              fi
            fi
          fi
        else
          warn "Could not find an AppImage asset in the latest release."
          echo "  Grab it by hand from https://cryptomator.org/downloads/linux/"
        fi
      fi

      # Fall back to a file you already have.
      if [[ -z "$aipath" ]]; then
        read -rp "Path to an AppImage you already downloaded (blank to skip): " aipath || true
        [[ -z "${aipath:-}" ]] || [[ -f "${aipath:-}" ]] || die "Not found: $aipath"
      fi

      if [[ -n "${aipath:-}" ]]; then
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [[ -x "$SCRIPT_DIR/appimage-manage" ]]; then
          "$SCRIPT_DIR/appimage-manage" install "$aipath" --name cryptomator
        else
          warn "appimage-manage is not executable next to this script."
          warn "  chmod +x appimage-manage"
          warn "  ./appimage-manage install '$aipath' --name cryptomator"
        fi
      else
        warn "Skipped. Once you have the file:"
        warn "  ./appimage-manage install <file> --name cryptomator"
      fi
      ;;
  esac

  cat <<'EOF'

  Cryptomator is a tray application. Sway has no system tray — enable
  waybar's tray module or the window will be unreachable after you close it:

    "modules-right": ["tray", ...],
    "tray": { "spacing": 10, "icon-size": 18 }

  Ordering with Nextcloud: point the Nextcloud client at the ENCRYPTED
  vault directory, never at the unlocked mountpoint. Syncing the decrypted
  view defeats the entire purpose.

EOF
}

# ---------------------------------------------------------------------------
# yazi — not in Debian's archive, in any suite, but upstream runs a signed
# APT repository of its own.
#
# That makes it the same shape as Tailscale and Mullvad: a real repo, a real
# signature, and apt keeps it current afterwards. Prefer it over the .deb
# assets on the GitHub release page, which carry no signature or checksum at
# all, and over `cargo install`, which pins you to a build you then have to
# remember to redo.
#
# Two channels are published, stable and nightly. Stable, obviously.
# ---------------------------------------------------------------------------
YAZI_REPO_BASE="https://yazi-rs.github.io/builds"

install_yazi() {
  if [[ ! -f /etc/apt/sources.list.d/yazi.list ]]; then
    say "Adding the yazi repository"

    local tmpkey
    tmpkey="$(mktemp)" || die "mktemp failed"
    # shellcheck disable=SC2064
    trap "rm -f '$tmpkey'" RETURN

    fetch_to "${YAZI_REPO_BASE}/yazi-keyring.gpg" "$tmpkey" \
      || die "Could not fetch the yazi signing key"
    looks_like_keyring "$tmpkey" \
      || die "What was downloaded is not a GPG keyring. Check ${YAZI_REPO_BASE}/"

    # Worth an eyeball the first time. Upstream publishes this fingerprint in
    # its installation docs; if it does not match, stop.
    if command -v gpg >/dev/null; then
      say "Key in that file"
      gpg --show-keys --with-colons "$tmpkey" 2>/dev/null \
        | awk -F: '/^fpr/{print "  "$10} /^uid/{print "  "$10}' | head -4
    fi

    sudo install -m 0644 "$tmpkey" /usr/share/keyrings/yazi-keyring.gpg

    echo "deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] ${YAZI_REPO_BASE}/ stable main" \
      | sudo tee /etc/apt/sources.list.d/yazi.list >/dev/null

    sudo apt-get update
  else
    say "yazi repository already configured"
  fi

  say "Installing yazi"
  sudo apt-get install -y yazi

  # --- Companions.
  #
  # yazi degrades silently without these: no previews, no image thumbnails,
  # no clipboard. Nothing errors, the panes are just empty, which reads like
  # a broken install rather than a missing helper.
  say "Checking the tools yazi shells out to"
  local want=(file ffmpegthumbnailer poppler-utils wl-clipboard jq fd-find ripgrep fzf zoxide imagemagick p7zip-full)
  local missing=() p
  for p in "${want[@]}"; do
    dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    say "All present."
  else
    warn "Missing: ${missing[*]}"
    local r=""
    read -rp "Install them? [Y/n] " r || true
    if [[ "${r:-y}" != [Nn]* ]]; then
      sudo apt-get install -y "${missing[@]}" || warn "Some packages failed; see apt output"
    fi
  fi

  cat <<'EOF'

  Updates come through apt from now on, along with everything else.

  Debian naming quirk that will bite you: fd is `fdfind` here and bat is
  `batcat`. Your shell aliases do not help — yazi execs these directly, so
  the names have to be right in yazi.toml or filtering and previews quietly
  do nothing.

  Wayland clipboard integration comes from wl-clipboard. Without it, yanking
  a path inside yazi never reaches the rest of your session.

  If you ever want the bleeding edge, upstream also publishes a nightly
  channel at the same base URL — a second sources.list entry with `nightly`
  in place of `stable`, then `apt install -t nightly yazi`.

EOF
}

# ---------------------------------------------------------------------------
# Newest release that actually carries a given asset.
#
# `releases/latest` is not good enough for every project. Obsidian regularly
# cuts Android-only releases: at the time of writing its latest is v1.13.8,
# whose sole asset is an .apk, while the desktop .deb lives in v1.13.7. Ask
# for the latest release and you get nothing, with no obvious reason why.
#
# The releases array comes back newest-first, so the first match is the
# newest release that has the asset.
# ---------------------------------------------------------------------------
gh_asset_from_recent() {   # $1 = owner/repo, $2 = asset suffix regex
  local json
  json="$(curl -fsSL "https://api.github.com/repos/$1/releases?per_page=15" || true)"
  [[ -n "$json" ]] || return 1
  printf '%s' "$json" \
    | grep -o "\"browser_download_url\"[[:space:]]*:[[:space:]]*\"[^\"]*${2}\"" \
    | head -1 | cut -d'"' -f4
}

# ---------------------------------------------------------------------------
# Obsidian — not in Debian's archive.
#
# Flathub is the default here rather than the .deb, and for once that is not
# just guide §6's "Flatpak for GUI applications" preference:
#
#   - Obsidian publishes NO signature and NO checksum with its releases. The
#     .deb is a file fetched over HTTPS and nothing more. Flathub delivers
#     over a GPG-signed OSTree repo.
#   - The .deb has no repository behind it, so it never updates. Flatpak
#     updates with everything else.
#   - The .deb is amd64 only. There is no arm64 build of it.
#
# The .deb is still offered, because dpkg-managed has its own appeal and the
# tradeoff is yours to make.
# ---------------------------------------------------------------------------
install_obsidian() {
  say "Obsidian — choose a channel"
  cat <<'EOF'

  1) Flatpak  — signed, auto-updating                      (recommended)
  2) .deb     — dpkg-managed, amd64 only, UNSIGNED, and no repository
                behind it, so updating means doing this again

EOF
  local choice=""
  read -rp "Which? [1/2] " choice || true

  if [[ "${choice:-1}" == "2" ]]; then
    local arch deburl dldir="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}" debpath
    arch="$(dpkg --print-architecture 2>/dev/null || echo amd64)"
    [[ "$arch" == "amd64" ]] \
      || die "Obsidian publishes no .deb for '$arch'. Use the Flatpak."

    say "Looking for the newest release carrying a .deb"
    deburl="$(gh_asset_from_recent obsidianmd/obsidian-releases '_amd64\.deb')" \
      || die "Could not reach the GitHub releases API."
    [[ -n "$deburl" ]] \
      || die "No .deb in the last 15 releases. Check https://obsidian.md/download"

    echo
    echo "  $deburl"
    echo "  No signature or checksum is published for this file."
    echo
    local r=""
    read -rp "Download and install it? [Y/n] " r || true
    [[ "${r:-y}" != [Nn]* ]] || { warn "Skipped."; return 0; }

    mkdir -p "$dldir"
    debpath="$dldir/$(basename "$deburl")"
    fetch_to "$deburl" "$debpath" || die "Download failed"
    # apt, not dpkg: it resolves dependencies rather than leaving a
    # half-configured package behind.
    sudo apt-get install -y "$debpath" || die "apt refused the package"
  else
    ensure_flatpak
    say "Installing Obsidian from Flathub"
    flatpak install -y flathub md.obsidian.Obsidian
    cat <<'EOF'

  Sandboxed, so it sees $HOME but not much else. If a vault lives on an
  external disk or another mount point, grant it explicitly:

    flatpak override --user --filesystem=/media md.obsidian.Obsidian

EOF
  fi

  cat <<'EOF'

  If a vault sits inside a Cryptomator vault or a Nextcloud folder, point
  Obsidian at the DECRYPTED mountpoint but let Nextcloud sync the ENCRYPTED
  directory — the same rule as everything else here.

EOF
}

# ---------------------------------------------------------------------------
# Vendor shell installers — the unverified channel.
#
# These use the installer each vendor documents as its recommended route.
# There is no signature, no checksum, and no apt integration: you are
# trusting TLS and the vendor, and nothing else. Every other app in this
# file has a signed repository behind it, so these are called out rather
# than quietly treated the same.
#
# NOT because nothing better exists — a deliberate choice, recorded so it
# does not read later as an oversight:
#
#   - Claude Code HAS a signed apt repository:
#       https://downloads.claude.ai/claude-code/apt/stable stable main
#     Origin Anthropic, amd64 and arm64, signed by
#     31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE ("Anthropic Claude Code
#     Release Signing"). Note the key is served from the claude-desktop
#     path — .../claude-desktop/key.asc — and the claude-code one 404s,
#     which is easy to read as "there is no repo".
#   - Codex signs its release binaries with Sigstore. The bundles are the
#     .sigstore assets on the GitHub release, the identity is the
#     rust-release.yml workflow in openai/codex, and cosign is packaged in
#     trixie, so verifying needs nothing unpackaged.
#   - Both are in nixpkgs (pkgs/by-name/cl/claude-code, .../co/codex),
#     which is what guide §6 earmarks Nix for.
#
# The vendor installers win here on cost, not on security: Claude Code
# self-updates after the first run, Codex needs one re-run to upgrade, and
# neither justifies a second package manager or a per-release cosign dance.
# If the freshness layer from §6 ever gets installed for neovim and the
# language servers, revisit this — at that point Nix is already there.
#
# What this does do is refuse to pipe. `curl … | sh` is worse than fetching
# and then running, for two concrete reasons:
#
#   - A truncated transfer executes whatever arrived. A shell reading from a
#     pipe runs each complete line as it lands, so a connection that dies
#     mid-file has already run half the script.
#   - The server sees a pipe. Response timing differs when the client is
#     consuming slowly, which is enough to serve different bytes to a piped
#     reader than to someone who saved the file and read it.
#
# So: download, show the size and hash, offer to read it, then run it. That
# does not make it verified. It makes it inspectable.
# ---------------------------------------------------------------------------
run_vendor_installer() {   # $1 = name, $2 = url, $3 = interpreter
  local name="$1" url="$2" sh_bin="${3:-sh}" tmp

  warn "$name has no signed repository. This installer is UNVERIFIED."
  echo "  $url"
  echo

  tmp="$(mktemp)" || die "mktemp failed"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN

  fetch_to "$url" "$tmp" || die "Could not download the $name installer"
  [[ -s "$tmp" ]] || die "The $name installer downloaded empty."

  printf '  %s bytes\n' "$(wc -c < "$tmp" | tr -d ' ')"
  command -v sha256sum >/dev/null && printf '  sha256 %s\n' "$(sha256sum "$tmp" | cut -d' ' -f1)"
  echo

  local r=""
  read -rp "Read it first? [y/N] " r || true
  if [[ "${r:-}" == [Yy]* ]]; then
    "${PAGER:-less}" "$tmp" || true
  fi

  r=""
  read -rp "Run this installer? [y/N] " r || true
  [[ "${r:-}" == [Yy]* ]] || { warn "Skipped."; return 0; }

  "$sh_bin" "$tmp" || die "$name installer failed"
}

# ---------------------------------------------------------------------------
# Claude Code — Anthropic's CLI. Native install, no Node required, and it
# updates itself in the background afterwards, so this runs once.
#
# A signed apt repository exists and is not used here; see the note above
# run_vendor_installer for the reasoning and the repo details.
# ---------------------------------------------------------------------------
install_claude_code() {
  say "Claude Code"
  run_vendor_installer "Claude Code" https://claude.ai/install.sh bash

  if command -v claude >/dev/null; then
    say "Installed: $(claude --version 2>/dev/null || echo 'on PATH')"
  else
    warn "claude is not on PATH yet — the installer puts it in ~/.local/bin,"
    warn "which your shell picks up at the next login."
  fi
}

# ---------------------------------------------------------------------------
# Codex — OpenAI's CLI. The npm route (`npm install -g @openai/codex`) is
# deliberately not used: nothing else here needs Node, and pulling in a whole
# toolchain for one binary is a poor trade. Unlike Claude Code, this one does
# not self-update — re-run to upgrade.
#
# The release binaries are Sigstore-signed and cosign is in trixie, so a
# verified install is possible; see the note above run_vendor_installer for
# why this takes the documented installer instead.
# ---------------------------------------------------------------------------
install_codex() {
  say "Codex"
  run_vendor_installer "Codex" https://chatgpt.com/codex/install.sh sh

  if command -v codex >/dev/null; then
    say "Installed: $(codex --version 2>/dev/null || echo 'on PATH')"
  else
    warn "codex is not on PATH yet — check where the installer placed it,"
    warn "and confirm ~/.local/bin is on PATH."
  fi
  echo "  No self-update: re-run ./install-thirdparty codex to upgrade."
}

# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  echo "Usage: $0 [--list] [--all] <app>..."; exit 1
fi

SELECTED=()
for arg in "$@"; do
  case "$arg" in
    --list) printf '  %s\n' "${APPS[@]}"; exit 0 ;;
    --all)  SELECTED=("${APPS[@]}") ;;
    -h|--help) sed -n "2,/^set -euo/p" "$0" | sed '$d'; exit 0 ;;
    *)
      [[ " ${APPS[*]} " == *" $arg "* ]] || die "unknown app: $arg"
      SELECTED+=("$arg") ;;
  esac
done

# De-duplicate while preserving order (`--all foo` would otherwise run
# foo's installer twice).
UNIQUE=()
for app in "${SELECTED[@]}"; do
  case " ${UNIQUE[*]} " in *" $app "*) continue ;; esac
  UNIQUE+=("$app")
done

for app in "${UNIQUE[@]}"; do
  case "$app" in
    tailscale)       install_tailscale ;;
    mullvad-browser) install_mullvad_browser ;;
    cryptomator)     install_cryptomator ;;
    yazi)            install_yazi ;;
    obsidian)        install_obsidian ;;
    claude-code)     install_claude_code ;;
    codex)           install_codex ;;
  esac
done

say "Done."
